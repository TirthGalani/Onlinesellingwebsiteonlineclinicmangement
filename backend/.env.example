[TEMPLATE]
# Required core configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-bytes
# One-time only: create the first management account, then delete this variable.
ADMIN_BOOTSTRAP_KEY=replace-with-a-separate-one-time-random-secret

# Public origin of the deployed app (used in email links). No trailing slash.
APP_ORIGIN=https://your-clinic.example.com
# IANA timezone used to interpret weekly availability. Defaults to America/New_York.
CLINIC_TIMEZONE=America/New_York

# Email delivery (Resend). Leave blank to record notifications as skipped.
RESEND_API_KEY=
MAIL_FROM=Maison Dental <notifications@your-clinic.example.com>
NOTIFICATIONS_EMAIL_ENABLED=true

# SMS delivery (Twilio). Phone numbers must use E.164, e.g. +12125550199.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFICATIONS_SMS_ENABLED=true

# Bearer token that Vercel Cron sends to /api/reminders. Generate a long random value.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Optional: lower the decoded attachment cap (hard maximum is 3 MB / 3145728).
ATTACHMENT_MAX_BYTES=3145728

# Public website booking. Slots come from clinician availability rules, so these
# only control how far ahead the website opens and how much notice a slot needs.
PUBLIC_BOOKING_DAYS_AHEAD=60
PUBLIC_BOOKING_LEAD_MINUTES=60
# Per-connection limits. On serverless each warm instance counts its own requests.
PUBLIC_BOOKING_LIMIT=8
PUBLIC_BOOKING_WINDOW_MINUTES=15
PUBLIC_LOOKUP_LIMIT=60
# 'masked' shows "First L." next to a review. Set to 'full' only with written permission.
PUBLIC_REVIEWS_NAMES=masked
